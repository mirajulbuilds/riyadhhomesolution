# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Cloudflare Pages, add the VITE_* values under Settings → Environment variables.

# Supabase project URL — Supabase dashboard → Project Settings → API (or Data API) → Project URL.
VITE_SUPABASE_URL=

# Supabase public key — the "anon" key (legacy) or the "publishable" key (sb_publishable_...).
# It is safe in the browser because Row Level Security protects every table.
# If both Supabase values are empty, the build uses the seed data in src/content/seed/.
VITE_SUPABASE_ANON_KEY=

# Google Tag Manager container ID, e.g. GTM-XXXXXXX. Leave empty to load no tracking.
VITE_GTM_ID=

# Public site address, used for canonical URLs, hreflang and the sitemap. No trailing slash.
VITE_SITE_URL=https://riyadhhomesolution.com

# Secret first URL segment of the admin panel (build time only, deliberately NOT VITE_ so it never
# reaches the public pages). Add the same value on Cloudflare Pages. 10+ characters, letters, digits,
# "-" or "_", no guessable words (admin, login, panel, dashboard, manage, wp-, riyadh, rhs, shop, 0500).
# Empty or weak = the site is built without any admin panel. Never commit the real value.
ADMIN_PATH=

# ---------------------------------------------------------------------------
# Edge Function secrets — set these in Supabase (Edge Functions → Secrets),
# NOT on Cloudflare and NOT with a VITE_ prefix (VITE_ values are shipped to the browser).
# ---------------------------------------------------------------------------

# Google Places API key, used only by the refresh-google-reviews function.
GOOGLE_PLACES_API_KEY=

# Google Place ID of the shop (also editable in the admin Settings screen).
GOOGLE_PLACE_ID=

# Cloudflare Pages deploy hook URL, used only by the publish-site function.
CF_DEPLOY_HOOK_URL=
